# /etc/family-finance/env — settings for the Family Finance service. Keep this file private
# (root:family-finance, mode 0640). Never commit real values.

# The spreadsheet id: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Service-account key (Google Cloud → IAM → Service accounts → Keys → Add key → JSON).
# Share the spreadsheet with the service account's e-mail (client_email) as Editor.
GOOGLE_APPLICATION_CREDENTIALS=/etc/family-finance/google-credentials.json

# The family connection code the phones enter (at least 24 characters). Reuse the
# FAMILY_ACCESS_TOKEN from the old Apps Script so connected phones keep working.
FAMILY_ACCESS_TOKEN=

# Optional: assistant explanations (DeepSeek). Leave empty to disable.
DEEPSEEK_API_KEY=
AI_PROVIDER=deepseek

# Listen address. Keep 127.0.0.1 behind Caddy/nginx (HTTPS); TRUST_PROXY=1 reads the client IP
# from X-Forwarded-For for the wrong-token throttle.
HOST=127.0.0.1
PORT=8091
TRUST_PROXY=1
